server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Fingerprinted build output never changes under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # robots.txt, sitemap and other static files, or the SPA shell for client-side
    # routes (/products, /research/my-article, ...). index.html must never be cached,
    # or visitors keep an old shell that points at deleted bundles.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
