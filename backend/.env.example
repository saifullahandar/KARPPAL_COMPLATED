# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave DATABASE_ENGINE=sqlite3 for local dev)
DATABASE_ENGINE=sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# CORS - the Vite dev server origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Superuser bootstrap (used only by seed_admin management command)
DJANGO_SUPERUSER_EMAIL=admin@karppal.af
DJANGO_SUPERUSER_PASSWORD=change-this-password

# --- Production / Railway only (see DEPLOYMENT_ROADMAP.md) ---------------------
# DATABASE_URL=${{Postgres.DATABASE_URL}}   # replaces the DATABASE_* lines above
# CORS_ALLOWED_ORIGINS=https://<frontend-domain>
# CSRF_TRUSTED_ORIGINS=https://<frontend-domain>
# DJANGO_ALLOWED_HOSTS=<custom-domain>      # .railway.app is always allowed
# SECURE_SSL_REDIRECT=True                  # False only for local http Docker
