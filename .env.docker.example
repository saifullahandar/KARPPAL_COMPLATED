# Copy to .env (next to docker-compose.yml) for `docker compose up --build`.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=karppal

# Optional: creates a super admin on first boot (never resets an existing one).
DJANGO_SUPERUSER_EMAIL=admin@karppal.af
DJANGO_SUPERUSER_PASSWORD=

# Baked into the frontend bundle at build time; rebuild after changing.
VITE_API_BASE_URL=http://localhost:8000/api/v1
